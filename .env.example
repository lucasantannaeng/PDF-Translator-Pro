# ==============================================================================
# PDF-Translator-Pro - Environment Variables Example
# ==============================================================================

# OpenRouter API Key (Access to DeepSeek V3, Gemini 2.5/3.7 Flash, Claude 3.5, etc.)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Direct DeepSeek API Key (api.deepseek.com)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Direct Gemini API Key (aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Default configuration
DEFAULT_PROVIDER=openrouter
DEFAULT_MODEL=deepseek/deepseek-chat
